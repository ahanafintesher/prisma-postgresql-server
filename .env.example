# WorkSphere EMS Platform Backend Environment Variables

# PostgreSQL Database (Neon Serverless Connection String with SSL)
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# JWT Token Secret Key (HMAC SHA-256)
JWT_SECRET="generate-a-secure-64-character-random-hex-string-for-production"

# Application Listening Port (Default: 5000)
PORT=5000

# Node Environment
NODE_ENV="development"

# Redis Cache Service
# Supports standard TCP (redis://localhost:6379), TLS (rediss://user:pass@host:port), Upstash, Redis Cloud
REDIS_URL="redis://127.0.0.1:6379"

# Enable/Disable Caching Layer (true/false)
REDIS_CACHE_ENABLED="true"

# Frontend Client Origin (Allowed in CORS)
FRONTEND_URL="http://localhost:3000,http://localhost:3001,https://admin.worksphere.com"
