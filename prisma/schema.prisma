generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id   String @id @default(uuid())
  name String

  email    String   @unique
  password String
  role     UserRole @default(User)
  orders   Orders[]

  @@map("users")
}

enum UserRole {
  User
  Admin
  Manager
}

model Product {
  id          String @id @default(uuid())
  title       String
  description String
  price       Int
  stock       Int

  @@map("products")
}

model Orders {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  quantity Int

  @@map("orders")
}
