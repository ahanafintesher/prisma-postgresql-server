

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(uuid())
  name String
  userName String
  email String 
  password String
  role UserRole @default(User)
  avatar String?

  @@map("users")
  @@unique([email, userName])

}

enum UserRole{
  User
  Admin
  Manager
}