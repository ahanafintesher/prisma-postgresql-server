# =============================================================================
# WorkSphere Super Admin Portal (ems-admin) — Frontend Environment Variables
# Copy this file to `ems-admin/.env.local` for local development
# Copy to `ems-admin/.env.production` for production deployments
# =============================================================================

# -----------------------------------------------------------------------------
# 1. External Express Gateway API Base URL
# -----------------------------------------------------------------------------
# Used by client-side browser fetch, SWR, TanStack Query, and lib/api-client.ts
# Default development port for outside backend: http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# 2. Server-Side API URL (Next.js App Router Server Actions & Route Handlers)
# -----------------------------------------------------------------------------
# Used by Next.js Server Components, Server Actions (lib/actions/*), and API routes
# On Docker/Kubernetes internal networks, this can point to the internal container DNS (e.g. http://backend:5000/api)
API_BASE_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# 3. Frontend Application Origin
# -----------------------------------------------------------------------------
# Used for OAuth callbacks, invitation redirect links, and session verification
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 4. WebSocket & Real-Time Event Stream
# -----------------------------------------------------------------------------
# Used for real-time announcements, notification alerts, and queue live updates
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# -----------------------------------------------------------------------------
# 5. Offline Fallback Resilience Flag
# -----------------------------------------------------------------------------
# Set to 'false' to enforce live HTTP communication with the Express backend
# Set to 'true' to allow automatic graceful fallback to mock data when backend is down
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false

# -----------------------------------------------------------------------------
# 6. HTTP Client Timeout (Milliseconds)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_TIMEOUT=15000

# -----------------------------------------------------------------------------
# 7. Production Gateway Target Example (for .env.production)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://admin.worksphere.com/api
# API_BASE_URL=https://admin.worksphere.com/api
# NEXT_PUBLIC_APP_URL=https://admin.worksphere.com
# NEXT_PUBLIC_WS_URL=wss://admin.worksphere.com
